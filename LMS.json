    {
      "name": "Borrow",
      "item": [
        {
          "name": "Borrow Book (Admin, on behalf of student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data.id) pm.environment.set('borrowId', data.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"userId\": \"{{studentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/borrow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow"
              ]
            },
            "description": "Requires bookId and studentId — run the Books and Students folders first. Admin can borrow on behalf of any student via userId; if omitted, the book is borrowed for whoever is logged in. Saves the new record's id as borrowId. dueDate defaults to 14 days from now if not provided. Decrements the book's availableCopies by 1."
          },
          "response": []
        },
        {
          "name": "Borrow Book (Student, for self)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/borrow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow"
              ]
            },
            "description": "Uses the student's own token (from Auth → Login (Student)) instead of the collection-level Admin bearer token — overridden here via the Authorization header. userId is omitted so the backend borrows for whoever the token belongs to. Try this only after returning the book from the request above, since a user can't borrow a copy they already hold."
          },
          "response": []
        },
        {
          "name": "Borrow Book - No Available Copies (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"userId\": \"{{studentId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/borrow",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow"
              ]
            },
            "description": "Demo request: run this a second time for the SAME book + student without returning first. Should fail with 400 'This book is already borrowed by this user' — proof the double-borrow business rule works."
          },
          "response": []
        },
        {
          "name": "Return Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"borrowId\": \"{{borrowId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/borrow/return",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "borrow",
                "return"
              ]
            },
            "description": "Marks the borrow record RETURNED, stamps returnDate, and increments the book's availableCopies by 1."
          },
          "response": []
