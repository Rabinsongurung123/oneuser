{
  "info": {
    "_postman_id": "2b677127-49c0-4b78-b858-2ae6055e4adc",
    "name": "Library Management System",
    "description": "API collection for the Library Management System backend (Node.js + Express + TypeScript + Prisma). Covers Auth, Categories, Books, and Students. Requests are ordered so running the collection top-to-bottom (Runner or Ctrl/Cmd+Enter through each folder) chains IDs and tokens automatically via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36413935"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data.accessToken) pm.environment.set('accessToken', data.data.accessToken);",
                  "if (data.data && data.data.refreshToken) pm.environment.set('refreshToken', data.data.refreshToken);",
                  "if (data.data && data.data.user && data.data.user.id) pm.environment.set('adminUserId', data.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@library.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded Admin account. Saves accessToken and refreshToken to the environment for use in every other request."
          },
          "response": []
        },
        {
          "name": "Login (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "if (data.data && data.data.accessToken) pm.environment.set('studentAccessToken', data.data.accessToken);",
                  "if (data.data && data.data.refreshToken) pm.environment.set('studentRefreshToken', data.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@library.com\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in as a Student created via the 'Create Student' request below. Run that first, or swap in any student's credentials. Tokens are saved separately as studentAccessToken so they don't overwrite the Admin's session."
          },
          "response": []
        },
